<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<Description>Time-dependent analysis (TDA: creep, shrinkage, construction stages) of an FEALiTE2D AnalysisRequest: conversion to the TDA input, run of the TDA solver, results in the FEALiTE2D response contract.</Description>
		<PackageTags>fealite2d tda creep shrinkage construction-stages prestress</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>0.1.0</Version>
		<PackageReleaseNotes>0.1.0: AnalysisRequest (+ TimeDependent) → .@za, run of the tda CLI, .tda.json → AnalysisResponse (load cases elastic, TimeDependentResults with states, effects, histories, composite parts).</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\FEALiTE2D.Api.Contracts\FEALiTE2D.Api.Contracts.csproj" />
	</ItemGroup>

</Project>
